#!/usr/bin/env node

import { existsSync, readFileSync } from "node:fs";
import path from "node:path";
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const rootDir = path.resolve(__dirname, "..");
const configFile = path.join(rootDir, ".rtnn", "instance.json");

if (!existsSync(configFile)) {
  console.error(`缺少实例契约文件: ${configFile}`);
  process.exit(1);
}

const config = JSON.parse(readFileSync(configFile, "utf8"));
const boundary = config.boundary;

if (!boundary) {
  console.error("实例契约缺少 boundary 配置");
  process.exit(1);
}

const allowedTrackedPaths = new Set(boundary.allowedTrackedPaths ?? []);
const forbiddenPathPrefixes = boundary.forbiddenPathPrefixes ?? [];
const forbiddenFileNames = new Set(boundary.forbiddenFileNames ?? []);
const forbiddenFileSuffixes = boundary.forbiddenFileSuffixes ?? [];

if (allowedTrackedPaths.size === 0) {
  console.error("boundary.allowedTrackedPaths 不能为空");
  process.exit(1);
}

const trackedFiles = gitLines(["ls-files"]);
const untrackedFiles = gitLines(["ls-files", "--others", "--exclude-standard"]);
const violations = [];

for (const file of trackedFiles) {
  if (!allowedTrackedPaths.has(file)) {
    violations.push(`tracked 文件超出白名单: ${file}`);
  }

  pushForbiddenViolations(file, "tracked");
}

for (const file of untrackedFiles) {
  if (!allowedTrackedPaths.has(file)) {
    violations.push(`untracked 文件超出白名单: ${file}`);
  }

  pushForbiddenViolations(file, "untracked");
}

if (violations.length > 0) {
  console.error("[instance-boundary] 边界校验失败:");
  for (const violation of violations) {
    console.error(`- ${violation}`);
  }
  process.exit(1);
}

console.log(
  `[instance-boundary] 通过: tracked=${trackedFiles.length}, untracked=${untrackedFiles.length}, mode=${boundary.mode ?? "unknown"}`,
);

function pushForbiddenViolations(filePath, sourceType) {
  const normalized = filePath.replace(/\\/g, "/");
  const baseName = path.posix.basename(normalized);

  for (const prefix of forbiddenPathPrefixes) {
    if (normalized.startsWith(prefix)) {
      violations.push(`${sourceType} 文件命中禁止目录前缀 ${prefix}: ${normalized}`);
      return;
    }
  }

  if (forbiddenFileNames.has(baseName)) {
    violations.push(`${sourceType} 文件命中禁止文件名 ${baseName}: ${normalized}`);
    return;
  }

  for (const suffix of forbiddenFileSuffixes) {
    if (normalized.endsWith(suffix)) {
      violations.push(`${sourceType} 文件命中禁止后缀 ${suffix}: ${normalized}`);
      return;
    }
  }
}

function gitLines(args) {
  const result = spawnSync("git", args, {
    cwd: rootDir,
    encoding: "utf8",
  });

  if (result.status !== 0) {
    console.error(result.stderr.trim() || `git ${args.join(" ")} 执行失败`);
    process.exit(result.status ?? 1);
  }

  return result.stdout
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean);
}

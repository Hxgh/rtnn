#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_FILE="$ROOT_DIR/.rtnn/instance.json"
BOUNDARY_SCRIPT="$ROOT_DIR/scripts/check-instance-boundary.mjs"

[[ -f "$CONFIG_FILE" ]] || {
  printf '缺少实例契约文件: %s\n' "$CONFIG_FILE" >&2
  exit 1
}

if ! command -v jq >/dev/null 2>&1; then
  printf '需要 jq 才能执行同步脚本。\n' >&2
  exit 1
fi

if ! command -v git >/dev/null 2>&1; then
  printf '需要 git 才能执行同步脚本。\n' >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  printf '需要 node 才能执行同步脚本。\n' >&2
  exit 1
fi

REMOTE_ONLY="false"
CHECK_ONLY="false"
SYNC_REF=""
TEMPLATE_MANAGED_PATHS=()

load_template_managed_paths() {
  local template_path

  while IFS= read -r template_path; do
    TEMPLATE_MANAGED_PATHS+=("$template_path")
  done < <(jq -r '.sync.templateManagedPaths[]' "$CONFIG_FILE")
}

clone_template_workspace() {
  local local_candidate

  if [[ -n "$REMOTE_URL_FROM_CONFIG" && "$REMOTE_URL_FROM_CONFIG" != "$UPSTREAM_URL" ]]; then
    printf '实例契约中的 templateSource.remoteUrl 与模板仓库配置不一致: %s\n' "$REMOTE_URL_FROM_CONFIG" >&2
    exit 1
  fi

  local_candidate="$(jq -r '.templateSource.localCandidatePaths[0] // empty' "$CONFIG_FILE")"
  if [[ -n "$local_candidate" && -d "$ROOT_DIR/$local_candidate/.git" ]]; then
    git clone --quiet "$ROOT_DIR/$local_candidate" "$TEMPLATE_WORKSPACE"
  else
    git clone --quiet "$UPSTREAM_URL" "$TEMPLATE_WORKSPACE"
  fi

  git -C "$TEMPLATE_WORKSPACE" checkout --quiet "$SYNC_REF"
}

render_template_assets() {
  node "$TEMPLATE_WORKSPACE/scripts/template/scaffold-instance-repo.mjs" \
    --target-dir="$GENERATED_INSTANCE" \
    --project-id="$PROJECT_ID" \
    --brand-name="$BRAND_NAME" \
    --cookie-prefix="$COOKIE_PREFIX" \
    --image-prefix="$IMAGE_PREFIX" \
    --deploy-application="$DEPLOY_APPLICATION" \
    --deploy-event-type="$DEPLOY_EVENT_TYPE" \
    --instance-repo="$INSTANCE_REPO" \
    --template-repo="$TEMPLATE_REPO" \
    --deploy-repo="$DEPLOY_REPO" \
    --base-domain="$BASE_DOMAIN" \
    --instance-purpose="$INSTANCE_PURPOSE" \
    --instance-ownership="$INSTANCE_OWNERSHIP" \
    --force >/dev/null
}

refresh_template_managed_paths() {
  local template_path source_path target_path

  for template_path in "${TEMPLATE_MANAGED_PATHS[@]}"; do
    source_path="$GENERATED_INSTANCE/$template_path"
    target_path="$ROOT_DIR/$template_path"

    if [[ ! -e "$source_path" ]]; then
      printf '生成的实例资产缺少模板托管路径: %s\n' "$template_path" >&2
      exit 1
    fi

    rm -rf "$target_path"
    mkdir -p "$(dirname "$target_path")"
    cp -R "$source_path" "$target_path"
  done
}

update_sync_metadata() {
  local next_config
  next_config="$TMP_DIR/instance.updated.json"

  jq \
    --arg ref "$SYNC_REF" \
    --arg commit "$RESOLVED_COMMIT" \
    '.sync.lastAssetSyncRef = $ref | .sync.lastAssetSyncCommit = $commit' \
    "$CONFIG_FILE" > "$next_config"

  mv "$next_config" "$CONFIG_FILE"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --remote-only)
      REMOTE_ONLY="true"
      shift
      ;;
    --check)
      CHECK_ONLY="true"
      shift
      ;;
    --ref)
      SYNC_REF="$2"
      shift 2
      ;;
    --initial)
      printf '%s\n' '--initial 已弃用，当前实例仓库不再做 upstream merge，将继续按模板资产刷新模式执行。'
      shift
      ;;
    --help|-h)
      cat <<'EOF'
用法:
  ./scripts/sync-from-template.sh [--remote-only] [--check] [--ref <ref>]

选项:
  --remote-only   仅配置 upstream remote
  --check         只校验指定模板 ref 是否可渲染当前实例，不刷新本地文件
  --ref <ref>     指定模板分支、tag 或 commit，默认读取 .rtnn/instance.json 中的 sync.defaultRef
EOF
      exit 0
      ;;
    *)
      printf '未知参数: %s\n' "$1" >&2
      exit 1
      ;;
  esac
done

UPSTREAM_REMOTE="$(jq -r '.sync.upstreamRemote' "$CONFIG_FILE")"
DEFAULT_REF="$(jq -r '.sync.defaultRef // .repositories.template.defaultRef // "main"' "$CONFIG_FILE")"
TEMPLATE_REPO="$(jq -r '.repositories.template.repo' "$CONFIG_FILE")"
INSTANCE_REPO="$(jq -r '.repositories.instance.repo' "$CONFIG_FILE")"
DEPLOY_REPO="$(jq -r '.repositories.deploy.repo' "$CONFIG_FILE")"
PROJECT_ID="$(jq -r '.identity.templateProjectId' "$CONFIG_FILE")"
BRAND_NAME="$(jq -r '.identity.templateBrandName' "$CONFIG_FILE")"
COOKIE_PREFIX="$(jq -r '.identity.templateCookiePrefix' "$CONFIG_FILE")"
IMAGE_PREFIX="$(jq -r '.release.imageNamePrefix' "$CONFIG_FILE")"
DEPLOY_APPLICATION="$(jq -r '.release.deployApplication' "$CONFIG_FILE")"
DEPLOY_EVENT_TYPE="$(jq -r '.release.deployEventType' "$CONFIG_FILE")"
INSTANCE_PURPOSE="$(jq -r '.instance.purpose' "$CONFIG_FILE")"
INSTANCE_OWNERSHIP="$(jq -r '.instance.ownership' "$CONFIG_FILE")"
BASE_DOMAIN="$(jq -r '.domains.production.root' "$CONFIG_FILE")"
REMOTE_URL_FROM_CONFIG="$(jq -r '.templateSource.remoteUrl // empty' "$CONFIG_FILE")"
load_template_managed_paths
SYNC_REF="${SYNC_REF:-$DEFAULT_REF}"
UPSTREAM_URL="https://github.com/${TEMPLATE_REPO}.git"

cd "$ROOT_DIR"

if git remote get-url "$UPSTREAM_REMOTE" >/dev/null 2>&1; then
  CURRENT_URL="$(git remote get-url "$UPSTREAM_REMOTE")"
  if [[ "$CURRENT_URL" != "$UPSTREAM_URL" ]]; then
    git remote set-url "$UPSTREAM_REMOTE" "$UPSTREAM_URL"
  fi
else
  git remote add "$UPSTREAM_REMOTE" "$UPSTREAM_URL"
fi

printf 'upstream remote: %s -> %s\n' "$UPSTREAM_REMOTE" "$UPSTREAM_URL"
printf 'template ref: %s\n' "$SYNC_REF"

if [[ "$REMOTE_ONLY" == "true" ]]; then
  printf '只完成 remote 配置，未执行同步。\n'
  exit 0
fi

node "$BOUNDARY_SCRIPT"

if [[ "$CHECK_ONLY" != "true" ]] && { ! git diff --quiet || ! git diff --cached --quiet; }; then
  printf '工作区不干净，请先提交或清理后再同步。\n' >&2
  exit 1
fi

TMP_DIR="$(mktemp -d)"
TEMPLATE_WORKSPACE="$TMP_DIR/template"
GENERATED_INSTANCE="$TMP_DIR/generated-instance"

cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

clone_template_workspace
RESOLVED_COMMIT="$(git -C "$TEMPLATE_WORKSPACE" rev-parse HEAD)"

render_template_assets

if [[ "$CHECK_ONLY" == "true" ]]; then
  TEST_ENV_FILE="$TMP_DIR/testing.env"
  node "$ROOT_DIR/scripts/render-runtime-env.mjs" \
    --environment testing \
    --template-root "$TEMPLATE_WORKSPACE" \
    --output "$TEST_ENV_FILE"
  printf '模板引用校验通过: ref=%s commit=%s\n' "$SYNC_REF" "$RESOLVED_COMMIT"
  exit 0
fi

refresh_template_managed_paths
update_sync_metadata
node "$BOUNDARY_SCRIPT"

printf '模板资产刷新完成。\n'
printf '模板 commit: %s\n' "$RESOLVED_COMMIT"
printf '建议继续执行：\n'
printf '  0. node scripts/check-instance-boundary.mjs\n'
printf '  1. git diff\n'
printf '  2. node scripts/render-runtime-env.mjs --environment testing\n'
printf '  3. 运行本实例需要的 smoke / 验收\n'

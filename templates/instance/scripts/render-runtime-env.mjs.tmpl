#!/usr/bin/env node

import { readFileSync, existsSync } from "node:fs";
import path from "node:path";
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const rootDir = path.resolve(__dirname, "..");
const configFile = path.join(rootDir, ".rtnn", "instance.json");

if (!existsSync(configFile)) {
  console.error(`缺少实例契约文件: ${configFile}`);
  process.exit(1);
}

const args = process.argv.slice(2);
let environment = "testing";
let outputFileArg = "";
let versionArg = "";
let sourceShaArg = "";
let databasePasswordArg = "";
let jwtAccessSecretArg = "";
let jwtRefreshSecretArg = "";

for (let index = 0; index < args.length; index += 1) {
  if (args[index] === "--environment") {
    environment = args[index + 1];
    index += 1;
  } else if (args[index] === "--output") {
    outputFileArg = args[index + 1];
    index += 1;
  } else if (args[index] === "--version") {
    versionArg = args[index + 1];
    index += 1;
  } else if (args[index] === "--source-sha") {
    sourceShaArg = args[index + 1];
    index += 1;
  } else if (args[index] === "--database-password") {
    databasePasswordArg = args[index + 1];
    index += 1;
  } else if (args[index] === "--jwt-access-secret") {
    jwtAccessSecretArg = args[index + 1];
    index += 1;
  } else if (args[index] === "--jwt-refresh-secret") {
    jwtRefreshSecretArg = args[index + 1];
    index += 1;
  } else {
    console.error(`未知参数: ${args[index]}`);
    process.exit(1);
  }
}

if (!["testing", "production"].includes(environment)) {
  console.error("--environment 只支持 testing 或 production");
  process.exit(1);
}

const config = JSON.parse(readFileSync(configFile, "utf8"));
const environmentDomains = config.domains?.[environment];
const environmentConfig = config.server?.environments?.[environment];
const postgresConfig = config.server?.sharedInfra?.postgres;
const projectId = config.identity?.templateProjectId || "{{PROJECT_ID}}";
const projectPrefix = projectId.replace(/[^a-zA-Z0-9]/g, "_").toUpperCase();

if (!environmentDomains) {
  console.error(`实例契约缺少 ${environment} 域名配置`);
  process.exit(1);
}

if (!environmentConfig) {
  console.error(`实例契约缺少 ${environment} 环境配置`);
  process.exit(1);
}

if (!postgresConfig?.host || !postgresConfig?.port) {
  console.error("实例契约缺少 PostgreSQL 运行时 host/port 配置");
  process.exit(1);
}

const deployRepoName = getRepoName(config.repositories?.deploy?.repo);
const templateRepoName = getRepoName(config.repositories?.template?.repo);
const deployRoot = path.resolve(rootDir, "..", deployRepoName);
const templateRoot = path.resolve(rootDir, "..", templateRepoName);
const renderScript = path.join(deployRoot, "scripts", "ops", "render-runtime-env.sh");
const templateEnvFile = path.join(templateRoot, ".env");
const outputFile =
  outputFileArg || path.join(deployRoot, "env", "runtime", `${environment}.env`);

if (!existsSync(renderScript)) {
  console.error(`缺少 deploy 渲染脚本: ${renderScript}`);
  process.exit(1);
}

if (!existsSync(templateEnvFile)) {
  console.error(`缺少模板 env 文件: ${templateEnvFile}`);
  process.exit(1);
}

const templateEnv = readRuntimeEnv(templateEnvFile);
const corsOrigins = [
  environmentDomains.admin,
  environmentDomains.app,
  environmentDomains.weapp,
];

if (environment === "testing") {
  const compatibilityAliases = config.domains?.compatibilityAliases?.testing ?? [];
  for (const alias of compatibilityAliases) {
    if (alias.startsWith("admin.")) {
      corsOrigins.push(alias);
    } else if (alias.startsWith("app.")) {
      corsOrigins.push(alias);
    } else if (alias.startsWith("weapp.")) {
      corsOrigins.push(alias);
    }
  }
}

const runtimeEnvFallback = readRuntimeEnv(outputFile);
const environmentPrefix = `${projectPrefix}_${environment.toUpperCase()}_`;
const templateHeadSha = resolveTemplateHeadSha(templateRoot);
const deployVersion =
  versionArg ||
  runtimeEnvFallback.DEPLOY_VERSION ||
  (environment === "testing" && templateHeadSha
    ? `main-${templateHeadSha.slice(0, 12)}`
    : "");
const deploySourceSha =
  sourceShaArg || runtimeEnvFallback.DEPLOY_SOURCE_SHA || templateHeadSha;
const databasePassword =
  databasePasswordArg ||
  process.env[`${environmentPrefix}DB_PASSWORD`] ||
  process.env[`${projectPrefix}_DEPLOY_DB_PASSWORD`] ||
  extractDatabasePassword(runtimeEnvFallback.DATABASE_URL || "") ||
  templateEnv.TEMPLATE_DATABASE_PASSWORD ||
  extractDatabasePassword(templateEnv.DATABASE_URL || "");
const jwtAccessSecret =
  jwtAccessSecretArg ||
  process.env[`${environmentPrefix}JWT_ACCESS_SECRET`] ||
  process.env[`${projectPrefix}_DEPLOY_JWT_ACCESS_SECRET`] ||
  runtimeEnvFallback.JWT_ACCESS_SECRET ||
  templateEnv.TEMPLATE_JWT_ACCESS_SECRET ||
  templateEnv.JWT_ACCESS_SECRET ||
  "";
const jwtRefreshSecret =
  jwtRefreshSecretArg ||
  process.env[`${environmentPrefix}JWT_REFRESH_SECRET`] ||
  process.env[`${projectPrefix}_DEPLOY_JWT_REFRESH_SECRET`] ||
  runtimeEnvFallback.JWT_REFRESH_SECRET ||
  templateEnv.TEMPLATE_JWT_REFRESH_SECRET ||
  templateEnv.JWT_REFRESH_SECRET ||
  "";

if (!databasePassword) {
  console.error(
    `${environment} 缺少数据库密码，请传入 --database-password、设置 ${environmentPrefix}DB_PASSWORD，或在模板 .env 中提供默认值`,
  );
  process.exit(1);
}

if (!jwtAccessSecret) {
  console.error(
    `${environment} 缺少 JWT access secret，请传入 --jwt-access-secret、设置 ${environmentPrefix}JWT_ACCESS_SECRET，或在模板 .env 中提供默认值`,
  );
  process.exit(1);
}

if (!jwtRefreshSecret) {
  console.error(
    `${environment} 缺少 JWT refresh secret，请传入 --jwt-refresh-secret、设置 ${environmentPrefix}JWT_REFRESH_SECRET，或在模板 .env 中提供默认值`,
  );
  process.exit(1);
}

const databaseUrl = buildDatabaseUrl({
  username: environmentConfig.dataIsolation.postgresUsername,
  password: databasePassword,
  host: postgresConfig.host,
  port: postgresConfig.port,
  database: environmentConfig.dataIsolation.postgresDatabase,
});

const commandArgs = [
  "--environment",
  environment,
  "--template-env-file",
  templateEnvFile,
  "--output",
  outputFile,
  "--database-url",
  databaseUrl,
  "--public-api-base-url",
  `https://${environmentDomains.api}`,
  "--public-backend-url",
  `https://${environmentDomains.api}`,
  "--public-admin-base-url",
  `https://${environmentDomains.admin}`,
  "--public-app-base-url",
  `https://${environmentDomains.app}`,
  "--public-weapp-base-url",
  `https://${environmentDomains.weapp}`,
  "--backend-bind-port",
  String(environmentConfig.bindPorts.backend),
  "--admin-bind-port",
  String(environmentConfig.bindPorts.admin),
  "--app-bind-port",
  String(environmentConfig.bindPorts.app),
  "--weapp-bind-port",
  String(environmentConfig.bindPorts.weapp),
  "--cors-origins",
  corsOrigins.map((value) => `https://${value}`).join(","),
  "--jwt-access-secret",
  jwtAccessSecret,
  "--jwt-refresh-secret",
  jwtRefreshSecret,
];

if (deployVersion) {
  commandArgs.push("--version", deployVersion);
}

if (deploySourceSha) {
  commandArgs.push("--source-sha", deploySourceSha);
}

const result = spawnSync(renderScript, commandArgs, {
  cwd: deployRoot,
  stdio: "inherit",
});

process.exit(result.status ?? 1);

function getRepoName(repo) {
  if (!repo) {
    return "";
  }

  const parts = repo.split("/");
  return parts[parts.length - 1];
}

function buildDatabaseUrl({ username, password, host, port, database }) {
  return `postgresql://${username}:${password}@${host}:${port}/${database}?schema=public`;
}

function extractDatabasePassword(databaseUrl) {
  if (!databaseUrl) {
    return "";
  }

  try {
    return new URL(databaseUrl).password;
  } catch {
    return "";
  }
}

function readRuntimeEnv(filePath) {
  if (!existsSync(filePath)) {
    return {};
  }

  const entries = {};
  const lines = readFileSync(filePath, "utf8").split(/\r?\n/);
  for (const line of lines) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith("#")) {
      continue;
    }

    const separatorIndex = trimmed.indexOf("=");
    if (separatorIndex === -1) {
      continue;
    }

    const key = trimmed.slice(0, separatorIndex);
    let value = trimmed.slice(separatorIndex + 1);
    if (
      (value.startsWith('"') && value.endsWith('"')) ||
      (value.startsWith("'") && value.endsWith("'"))
    ) {
      value = value.slice(1, -1);
    }
    entries[key] = value;
  }

  return entries;
}

function resolveTemplateHeadSha(templateRootPath) {
  const result = spawnSync("git", ["rev-parse", "HEAD"], {
    cwd: templateRootPath,
    encoding: "utf8",
  });

  if (result.status !== 0) {
    return "";
  }

  return result.stdout.trim();
}

{
  "version": "v4",
  "instance": {
    "repository": "{{INSTANCE_REPO}}",
    "purpose": "{{INSTANCE_PURPOSE}}",
    "ownership": "{{INSTANCE_OWNERSHIP}}"
  },
  "identity": {
    "templateProjectId": "{{PROJECT_ID}}",
    "templateBrandName": "{{BRAND_NAME}}",
    "templateCookiePrefix": "{{COOKIE_PREFIX}}"
  },
  "repositories": {
    "template": {
      "repo": "{{TEMPLATE_REPO}}",
      "defaultRef": "main"
    },
    "deploy": {
      "repo": "{{DEPLOY_REPO}}",
      "defaultRef": "main"
    },
    "instance": {
      "repo": "{{INSTANCE_REPO}}",
      "defaultRef": "main"
    }
  },
  "release": {
    "imageNamePrefix": "{{IMAGE_PREFIX}}",
    "deployApplication": "{{DEPLOY_APPLICATION}}",
    "deployEventType": "{{DEPLOY_EVENT_TYPE}}"
  },
  "sync": {
    "mode": "template-assets-refresh",
    "upstreamRemote": "upstream",
    "defaultRef": "main",
    "templateManagedPaths": [
      ".gitignore",
      "CLAUDE.md",
      "scripts/check-instance-boundary.mjs",
      "scripts/render-runtime-env.mjs",
      "scripts/sync-from-template.sh"
    ],
    "instanceOwnedPaths": [
      ".rtnn/acceptance.md",
      ".rtnn/instance.json",
      "README.md"
    ],
    "lastAssetSyncRef": "main",
    "lastAssetSyncCommit": "pending-first-sync",
    "validation": {
      "environment": "testing",
      "command": "node scripts/render-runtime-env.mjs --environment testing"
    }
  },
  "templateSource": {
    "model": "reference-workspace",
    "note": [
      "实例仓库不长期承载模板源码",
      "同步与校验通过临时模板工作区完成"
    ],
    "localCandidatePaths": [
      "../{{TEMPLATE_REPO_NAME}}"
    ],
    "remoteUrl": "https://github.com/{{TEMPLATE_REPO}}.git"
  },
  "boundary": {
    "mode": "thin-instance",
    "allowedTrackedPaths": [
      ".gitignore",
      ".rtnn/acceptance.md",
      ".rtnn/instance.json",
      "CLAUDE.md",
      "README.md",
      "scripts/check-instance-boundary.mjs",
      "scripts/render-runtime-env.mjs",
      "scripts/sync-from-template.sh"
    ],
    "forbiddenPathPrefixes": [
      ".github/",
      "apps/",
      "packages/",
      "docs/",
      "compose/",
      "tooling/",
      "templates/",
      "env/",
      "state/"
    ],
    "forbiddenFileNames": [
      ".env",
      ".env.local",
      ".env.testing",
      ".env.production"
    ],
    "forbiddenFileSuffixes": [
      ".pem",
      ".key",
      ".crt",
      ".p12",
      ".pfx"
    ]
  },
  "environmentModel": {
    "remoteEnvironments": [
      "testing",
      "production"
    ],
    "triggerPolicy": {
      "testing": "automatic-from-template-main",
      "production": "manual-promote-from-deploy-repository"
    },
    "note": [
      "local 由模板仓库负责，不属于 deploy 环境矩阵"
    ]
  },
  "domains": {
    "testing": {
      "root": "{{TESTING_ROOT}}",
      "api": "{{TESTING_API}}",
      "admin": "{{TESTING_ADMIN}}",
      "app": "{{TESTING_APP}}",
      "weapp": "{{TESTING_WEAPP}}"
    },
    "production": {
      "root": "{{PRODUCTION_ROOT}}",
      "api": "{{PRODUCTION_API}}",
      "admin": "{{PRODUCTION_ADMIN}}",
      "app": "{{PRODUCTION_APP}}",
      "weapp": "{{PRODUCTION_WEAPP}}"
    },
    "compatibilityAliases": {
      "testing": []
    }
  },
  "server": {
    "name": "{{PROJECT_ID}}-instance",
    "hostModel": "single-host",
    "placement": "shared-host-isolated-stack",
    "topology": "docker-compose-plus-existing-nginx",
    "sharedInfra": {
      "proxy": {
        "provider": "existing-nginx",
        "containerName": "nginx-proxy",
        "ingressMode": "subdomain"
      },
      "network": {
        "name": "shared-network",
        "mode": "shared-existing",
        "ingressAliasMode": "environment-scoped"
      },
      "postgres": {
        "mode": "shared-existing",
        "containerName": "standalone-postgres",
        "host": "standalone-postgres",
        "port": 5432,
        "isolationStrategy": "per-environment-database-and-user"
      },
      "redis": {
        "mode": "shared-existing",
        "containerName": "standalone-redis",
        "host": "standalone-redis",
        "port": 6379,
        "isolationStrategy": "per-environment-db-and-key-prefix"
      },
      "runner": {
        "enabled": true,
        "mode": "same-host-systemd-service",
        "scope": "repo-only",
        "serviceName": "{{RUNNER_SERVICE_NAME}}",
        "githubProxy": "configure-if-needed"
      }
    },
    "tls": {
      "mode": "shared-unified-san-cert",
      "certificateName": "configure-certificate-name",
      "hosts": [
        "{{PRODUCTION_ROOT}}",
        "{{PRODUCTION_API}}",
        "{{PRODUCTION_ADMIN}}",
        "{{PRODUCTION_APP}}",
        "{{PRODUCTION_WEAPP}}",
        "{{TESTING_ROOT}}",
        "{{TESTING_API}}",
        "{{TESTING_ADMIN}}",
        "{{TESTING_APP}}",
        "{{TESTING_WEAPP}}"
      ]
    },
    "paths": {
      "root": "{{ROOT_PATH}}",
      "runtime": "{{ROOT_PATH}}/runtime",
      "infra": "{{ROOT_PATH}}/infra",
      "ops": "{{ROOT_PATH}}/ops",
      "env": "{{ROOT_PATH}}/env",
      "data": "{{ROOT_PATH}}/data"
    },
    "environments": {
      "testing": {
        "state": "planned",
        "trigger": "automatic-from-template-main",
        "composeProjectName": "{{PROJECT_ID}}-testing",
        "activeRelease": "pending-first-deploy",
        "bindPorts": {
          "backend": 15100,
          "admin": 15101,
          "app": 15102,
          "weapp": 15103
        },
        "dataIsolation": {
          "postgresDatabase": "{{PROJECT_ID}}_testing",
          "postgresUsername": "{{PROJECT_ID}}_testing",
          "redisDb": 2,
          "redisKeyPrefix": "{{PROJECT_ID}}:testing:"
        }
      },
      "production": {
        "state": "planned",
        "trigger": "manual-from-deploy-repository",
        "composeProjectName": "{{PROJECT_ID}}-production",
        "activeRelease": "pending-first-deploy",
        "cutoverStatus": "not-deployed",
        "bindPorts": {
          "backend": 16100,
          "admin": 16101,
          "app": 16102,
          "weapp": 16103
        },
        "dataIsolation": {
          "postgresDatabase": "{{PROJECT_ID}}_production",
          "postgresUsername": "{{PROJECT_ID}}_production",
          "redisDb": 3,
          "redisKeyPrefix": "{{PROJECT_ID}}:production:"
        }
      }
    }
  }
}

{
  "identifier": "admin-desktop-remote",
  "description": "Allow the RTNN admin desktop shell to expose minimal native capabilities to approved admin URLs.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:5101",
      "http://localhost:5101/*",
      "https://admin.rtnn.invalid",
      "https://admin.rtnn.invalid/*"
    ]
  },
  "permissions": ["core:default", "opener:default", "updater:default"]
}

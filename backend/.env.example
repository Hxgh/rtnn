NODE_ENV=development
PORT={{TEMPLATE_BACKEND_PORT}}
# 本地开发使用 docker compose 时，该 URL 默认指向根级模板参数定义的 PostgreSQL。
DATABASE_URL=postgresql://{{TEMPLATE_DATABASE_USER}}:{{TEMPLATE_DATABASE_PASSWORD}}@{{TEMPLATE_DATABASE_HOST}}:{{TEMPLATE_DATABASE_PORT}}/{{TEMPLATE_DATABASE_NAME}}?schema=public
TEMPLATE_PROJECT_ID={{TEMPLATE_PROJECT_ID}}
TEMPLATE_BRAND_NAME={{TEMPLATE_BRAND_NAME}}
TEMPLATE_COOKIE_PREFIX={{TEMPLATE_COOKIE_PREFIX}}
TEMPLATE_ADMIN_EMAIL={{TEMPLATE_ADMIN_EMAIL}}
TEMPLATE_ADMIN_PASSWORD={{TEMPLATE_ADMIN_PASSWORD}}
TEMPLATE_ADMIN_DISPLAY_NAME={{TEMPLATE_ADMIN_DISPLAY_NAME}}
TEMPLATE_CUSTOMER_EMAIL={{TEMPLATE_CUSTOMER_EMAIL}}
TEMPLATE_CUSTOMER_PASSWORD={{TEMPLATE_CUSTOMER_PASSWORD}}
TEMPLATE_CUSTOMER_DISPLAY_NAME={{TEMPLATE_CUSTOMER_DISPLAY_NAME}}
LOGIN_RATE_LIMIT_WINDOW_SEC=300
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
JWT_ISSUER={{TEMPLATE_JWT_ISSUER}}
JWT_AUDIENCE={{TEMPLATE_JWT_AUDIENCE}}
JWT_ACCESS_SECRET={{TEMPLATE_JWT_ACCESS_SECRET}}
JWT_REFRESH_SECRET={{TEMPLATE_JWT_REFRESH_SECRET}}
JWT_ACCESS_EXPIRES_IN={{TEMPLATE_JWT_ACCESS_EXPIRES_IN}}
JWT_REFRESH_EXPIRES_IN={{TEMPLATE_JWT_REFRESH_EXPIRES_IN}}

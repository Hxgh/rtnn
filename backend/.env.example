NODE_ENV=development
PORT=5100
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rtnn?schema=public
LOGIN_RATE_LIMIT_WINDOW_SEC=300
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
JWT_ISSUER=rtnn-backend
JWT_AUDIENCE=rtnn-clients
JWT_ACCESS_SECRET=replace-this-with-a-long-random-string-access
JWT_REFRESH_SECRET=replace-this-with-a-long-random-string-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

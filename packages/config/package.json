{
  "name": "@rtnn/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./template-access": {
      "types": "./dist/template-access.d.ts",
      "import": "./dist/template-access.js",
      "require": "./dist/template-access.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/template-access.ts --format esm,cjs --dts --clean",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  }
}

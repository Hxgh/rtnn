{
  "name": "@rtnn/api-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "@rtnn/config": "workspace:*",
    "@rtnn/shared-types": "workspace:*"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "generate": "openapi-typescript ../../apps/backend/openapi.json -o src/generated/openapi.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  }
}

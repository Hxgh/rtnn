{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/runtime/run-target-command.mjs admin pnpm run dev:raw",
    "dev:raw": "next dev -p 5101",
    "build": "node ../../scripts/runtime/run-target-command.mjs admin pnpm run build:raw",
    "build:raw": "next build",
    "start": "pnpm run start:standalone",
    "start:standalone": "node ../../scripts/runtime/run-target-command.mjs admin pnpm run start:standalone:raw",
    "start:standalone:raw": "node ../../scripts/runtime/run-next-standalone.mjs apps/admin 5101",
    "lint": "eslint",
    "typecheck": "node ../../scripts/runtime/run-target-command.mjs admin pnpm run typecheck:raw",
    "typecheck:raw": "next typegen && tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@rtnn/api-sdk": "workspace:*",
    "@rtnn/config": "workspace:*",
    "@rtnn/shared-types": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.7.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

{
  "name": "backend",
  "version": "0.1.0",
  "description": "rtnn backend template kernel",
  "author": "RTNN",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run dev:raw",
    "dev:raw": "nest start --watch --builder tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run start:raw",
    "start:raw": "nest start",
    "start:dev": "pnpm run dev",
    "start:debug": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run start:debug:raw",
    "start:debug:raw": "nest start --debug --watch --builder tsc",
    "start:prod": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run start:prod:raw",
    "start:prod:raw": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "pnpm run test:unit",
    "test:unit": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run test:unit:raw",
    "test:unit:raw": "node ../../scripts/runtime/run-jest.mjs -- --runInBand",
    "test:integration": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run test:integration:raw",
    "test:integration:raw": "node ../../scripts/runtime/run-jest.mjs -- --config ./test/jest-integration.json --runInBand",
    "test:watch": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run test:watch:raw",
    "test:watch:raw": "node ../../scripts/runtime/run-jest.mjs -- --watch",
    "test:cov": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run test:cov:raw",
    "test:cov:raw": "node ../../scripts/runtime/run-jest.mjs -- --coverage",
    "test:debug": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run test:debug:raw",
    "test:debug:raw": "node ../../scripts/runtime/run-jest.mjs --node-arg=--inspect-brk --node-arg=-r --node-arg=tsconfig-paths/register --node-arg=-r --node-arg=ts-node/register -- --runInBand",
    "test:e2e": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run test:e2e:raw",
    "test:e2e:raw": "node ../../scripts/runtime/run-jest.mjs -- --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run prisma:migrate:dev:raw",
    "prisma:migrate:dev:raw": "prisma migrate dev",
    "prisma:migrate:deploy": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run prisma:migrate:deploy:raw",
    "prisma:migrate:deploy:raw": "prisma migrate deploy",
    "prisma:seed": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run prisma:seed:raw",
    "prisma:seed:raw": "prisma db seed",
    "bootstrap:template-access:raw": "node dist/scripts/bootstrap-template-access.js",
    "prisma:studio": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run prisma:studio:raw",
    "prisma:studio:raw": "prisma studio",
    "generate:enums": "prisma generate",
    "generate:permissions": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run generate:permissions:raw",
    "generate:permissions:raw": "ts-node -r tsconfig-paths/register src/scripts/generate-permissions.ts",
    "openapi:export": "node ../../scripts/runtime/run-target-command.mjs backend pnpm run openapi:export:raw",
    "openapi:export:raw": "ts-node -r tsconfig-paths/register src/scripts/export-openapi.ts",
    "export:openapi": "pnpm run openapi:export",
    "check:release": "pnpm run generate:permissions && pnpm run export:openapi && pnpm run typecheck && pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e"
  },
  "dependencies": {
    "@rtnn/config": "workspace:*",
    "@rtnn/shared-schemas": "workspace:*",
    "@rtnn/shared-types": "workspace:*",
    "@nestjs/config": "^4.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "joi": "^17.13.3",
    "prisma": "^6.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}

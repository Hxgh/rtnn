{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/runtime/run-target-command.mjs app pnpm run dev:raw",
    "dev:raw": "next dev -p 5102",
    "build": "node ../../scripts/runtime/run-target-command.mjs app pnpm run build:raw",
    "build:raw": "next build",
    "start": "pnpm run start:standalone",
    "start:standalone": "node ../../scripts/runtime/run-target-command.mjs app pnpm run start:standalone:raw",
    "start:standalone:raw": "node ../../scripts/runtime/run-next-standalone.mjs apps/app 5102",
    "lint": "eslint",
    "typecheck": "node ../../scripts/runtime/run-target-command.mjs app pnpm run typecheck:raw",
    "typecheck:raw": "tsc --noEmit"
  },
  "dependencies": {
    "@rtnn/api-sdk": "workspace:*",
    "@rtnn/config": "workspace:*",
    "@rtnn/native-bridge": "workspace:*",
    "@rtnn/shared-types": "workspace:*",
    "html5-qrcode": "^2.3.8",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

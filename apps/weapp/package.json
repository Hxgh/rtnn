{
  "name": "weapp",
  "version": "0.1.0",
  "private": true,
  "description": "Taro + React weapp template app",
  "scripts": {
    "dev:weapp": "node ../../scripts/run-target-command.mjs weapp pnpm run dev:weapp:raw",
    "dev:weapp:raw": "taro build --type weapp --watch",
    "build:weapp": "node ../../scripts/run-target-command.mjs weapp pnpm run build:weapp:raw",
    "build:weapp:raw": "taro build --type weapp",
    "dev:h5": "node ../../scripts/run-target-command.mjs weapp pnpm run dev:h5:raw",
    "dev:h5:raw": "taro build --type h5 --watch -p 5103",
    "build:h5": "node ../../scripts/run-target-command.mjs weapp pnpm run build:h5:raw",
    "build:h5:raw": "taro build --type h5",
    "typecheck": "node ../../scripts/run-target-command.mjs weapp pnpm run typecheck:raw",
    "typecheck:raw": "tsc --noEmit"
  },
  "dependencies": {
    "@rtnn/api-sdk": "workspace:*",
    "@rtnn/config": "workspace:*",
    "@rtnn/shared-types": "workspace:*",
    "@tarojs/components": "4.1.11",
    "@tarojs/react": "4.1.11",
    "@tarojs/runtime": "4.1.11",
    "@tarojs/shared": "4.1.11",
    "@tarojs/taro": "4.1.11",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.27.1",
    "@tarojs/cli": "4.1.11",
    "@tarojs/plugin-framework-react": "4.1.11",
    "@tarojs/plugin-platform-h5": "4.1.11",
    "@tarojs/plugin-platform-weapp": "4.1.11",
    "@tarojs/vite-runner": "4.1.11",
    "@types/node": "^20.17.30",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-preset-taro": "4.1.11",
    "typescript": "^5.6.3",
    "vite": "^4.5.5"
  }
}
